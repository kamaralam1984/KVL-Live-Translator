# Copy to .env for local development. Never commit the real .env file.

# WebSocket server port
BACKEND_WS_PORT=4319

# SQLite database file path. When spawned by Electron, backendProcess.ts
# overrides this with app.getPath('userData') + /kvl-live-translator.sqlite3.
BACKEND_DB_PATH=./data/kvl.sqlite3

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Phase 13 — required. A shared secret the WS server checks on every
# connection attempt (verifyClient, before 'connection'/register() ever
# fires) so an arbitrary local process/webpage can't just open
# ws://127.0.0.1:<port> and read live meeting broadcasts. When Electron
# spawns the backend (backendProcess.ts), it generates a fresh 256-bit token
# per launch and passes it as this env var, overriding whatever .env has —
# dotenv never overrides an already-set process.env value. This .env-file
# value only matters for bare `pnpm dev`/manual backend boots outside
# Electron. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_WS_TOKEN=

# Phase 3 — optional local Whisper (whisper.cpp) support. Unset means
# LocalWhisperProvider honestly reports itself unavailable and the router
# falls through to the cloud provider (configured via the API Providers
# screen, not env vars — its key is encrypted at rest, see README).
# WHISPER_CPP_BINARY_PATH=/usr/local/bin/whisper-cli
# WHISPER_CPP_MODEL_PATH=/usr/local/share/whisper/ggml-base.en.bin

# Phase 4 — optional override for a self-hosted LibreTranslate instance.
# Unset defaults to the public https://libretranslate.com API.
# LIBRETRANSLATE_BASE_URL=http://localhost:5000

# Phase 4 — optional override for the Argos Translate python interpreter,
# if it isn't the default `python3` on PATH.
# ARGOS_PYTHON_BIN=/usr/bin/python3

# Dev-time fallback secrets for provider adapters. Never hardcode
# real keys here — this file only documents the expected variable names.
# OPENAI_API_KEY=
# AZURE_SPEECH_KEY=
# ELEVENLABS_API_KEY=
