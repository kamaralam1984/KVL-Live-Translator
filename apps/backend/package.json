{
  "name": "@kvl/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test:speech-core": "tsx src/speech/__tests__/router.node-test.ts",
    "test:translation-core": "tsx src/translation/__tests__/translation.node-test.ts",
    "test:response-core": "tsx src/response/__tests__/response.node-test.ts",
    "test:tts-core": "tsx src/tts/__tests__/tts.node-test.ts",
    "test:explain-core": "tsx src/explain/__tests__/explain.node-test.ts",
    "test:copilot-core": "tsx src/copilot/__tests__/copilot.node-test.ts",
    "test:summary-core": "tsx src/summary/__tests__/summary.node-test.ts",
    "test:cost-core": "tsx src/cost/__tests__/cost.node-test.ts",
    "test:security-core": "tsx src/ws/__tests__/security.node-test.ts"
  },
  "dependencies": {
    "@kvl/shared": "workspace:*",
    "@kvl/audio": "workspace:*",
    "@kvl/speech": "workspace:*",
    "@kvl/translation": "workspace:*",
    "@kvl/response": "workspace:*",
    "@kvl/tts": "workspace:*",
    "@kvl/explain": "workspace:*",
    "@kvl/copilot": "workspace:*",
    "@kvl/summary": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "ws": "^8.21.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "dotenv": "^17.4.2",
    "zod": "^3.24.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.23.12",
    "tsup": "^8.3.5",
    "@types/node": "^22",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ws": "^8.5.13",
    "@types/uuid": "^10.0.0"
  }
}
